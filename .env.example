# Copier ce fichier en .env (ignoré par Git) à la racine du repo, puis remplir.
# Ne jamais committer .env ni coller une clé dans un message ou un document du repo.

# Clé d'API Bedrock de courte durée (Workshop Studio ou console Bedrock). Elle expire au bout de 12 heures au plus.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
# Consigne de l'équipe : Opus 5.5, à défaut Fable 5.1 ou Opus 4.8. Jamais Sonnet (voir shared/aws-bedrock.md).
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5

# Jeton Apify, pour la collecte Web de l oracle (ia-1/oracle/collecte_apify.py)
APIFY_TOKEN=
