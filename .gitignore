# Les modèles sans valeur se committent
!.env.example

# Fichiers vivants du relais (session en cours, jamais dans le dépôt)
shared/events.jsonl
shared/alerts.jsonl
shared/flags.jsonl

# Modèle d anomalie appris (régénérable : python -m score.anomalie ...)
